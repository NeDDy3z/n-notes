{
  "xtemplate": 1,
  "id": "xtemplate.examples.calligraphy",
  "name": "Calligraphy guide",
  "description": "Ascender, waist, base and descender lines measured in nib widths, with a shaded x-height band and slant lines.",
  "license": "MIT",
  "tags": ["lettering", "calligraphy"],
  "params": {
    "nib": { "type": "length", "default": "3mm", "min": "1mm", "max": "8mm", "label": "Nib width", "role": "spacing" },
    "xheight": { "type": "number", "default": 5, "min": 3, "max": 8, "step": 0.5, "label": "x-height (nib widths)" },
    "slant": { "type": "number", "default": 7, "min": 0, "max": 20, "label": "Slant (degrees)" }
  },
  "items": [
    { "type": "group", "inset": ["15mm", "12mm"], "clip": true, "children": [
      { "type": "hatch", "angle": "90 - slant", "period": "12mm", "strokeWidth": "0.15mm", "opacity": 0.3 },
      { "type": "repeat", "axis": "y", "period": "nib * (xheight + 10)", "fit": "space", "children": [
        { "type": "rect", "y": "nib * 4", "h": "nib * xheight", "stroke": "none", "fill": "accent", "opacity": 0.12 },
        { "type": "hline", "y": 0, "dash": ["1mm", "1mm"], "opacity": 0.6 },
        { "type": "hline", "y": "nib * 4" },
        { "type": "hline", "y": "nib * (4 + xheight)", "strokeWidth": "0.4mm" },
        { "type": "hline", "y": "nib * (8 + xheight)", "dash": ["1mm", "1mm"], "opacity": 0.6 }
      ]}
    ]}
  ]
}
